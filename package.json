{
  "name": "inventracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./src/app/globals.css -o ./public/app.css --minify",
    "dev": "npm run build:css && next dev",
    "build": "npm run build:css && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "validate": "npm run lint && npm run typecheck && npm run build",
    "assistant:eval": "node scripts/eval-assistant.mjs",
    "ai:install-local": "node scripts/install-local-ai.mjs",
    "ai:check-local": "node scripts/check-local-ai.mjs",
    "billing:check": "node --experimental-strip-types scripts/check-billing-quantities.mts && node --experimental-strip-types scripts/check-billing-plans.mts",
    "engines:firestore": "node scripts/check-inventory-firestore.mjs",
    "engines:swift": "swiftc ios/InvenTracker/InvenTracker/Core/Models.swift scripts/check-transfer-contract.swift -o /tmp/inventraker-transfer-contract-check && /tmp/inventraker-transfer-contract-check fixtures/engine-contracts/transfer-v1.json",
    "engines:check": "node --experimental-strip-types scripts/check-inventory-engine.mts && node --experimental-strip-types scripts/check-spot-check-engine.mts && node --experimental-strip-types scripts/check-receiving-engine.mts && node --experimental-strip-types scripts/check-restock-engine.mts && node --experimental-strip-types scripts/check-discard-engine.mts && node --experimental-strip-types scripts/check-portion-engine.mts && node --experimental-strip-types scripts/check-threshold-engine.mts",
    "stock:check": "node --experimental-strip-types scripts/check-stock-invariants.mts",
    "workspace:providers": "node --experimental-strip-types scripts/check-workspace-providers.mts",
    "workspace:check": "node --experimental-strip-types scripts/check-workspace-invariants.mts",
    "orders:check": "node --experimental-strip-types scripts/check-order-invariants.mts",
    "today:check": "node --experimental-strip-types scripts/check-today-invariants.mts",
    "pilot:check": "node --experimental-strip-types scripts/check-pilot-cycle.mts",
    "intelligence:check": "node --experimental-strip-types scripts/check-operational-intelligence.mts",
    "firebase:reset": "node scripts/reset-firebase.mjs",
    "firebase:seed": "node scripts/seed-firebase.mjs",
    "firebase:seed-admin": "node scripts/seed-platform-admin.mjs",
    "firebase:seed-test-users": "node scripts/seed-auth-test-users.mjs",
    "firebase:seed-demo-store": "node scripts/seed-demo-store.mjs",
    "firebase:provision-test-org": "node scripts/provision-test-organization.mjs",
    "firebase:migrate-batches": "node scripts/migrate-inventory-batches.mjs"
  },
  "dependencies": {
    "@emnapi/runtime": "1.11.3",
    "@opentelemetry/api": "1.9.1",
    "@types/pdf-parse": "^1.1.5",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.4.0",
    "fuse.js": "^7.4.2",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.0",
    "next": "^14.2.35",
    "pdf-parse": "^2.4.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "stripe": "^22.3.0",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^20.17.23",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  }
}
